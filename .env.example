# Optional OpenAI-compatible model for synthetic persona surveys.
# Without these values, the app still collects, validates, estimates and reports,
# but refuses to manufacture persona survey answers.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna

# Explicitly enables a clearly labelled deterministic demo response generator.
# It is never a substitute for a configured model or an actual survey.
PERSONA_RESTORER_DEMO_MODEL=0

# Optional gateway protection for non-loopback API exposure.
GATEWAY_TOKEN=

# Optional Korean public-data connectors. Keys are read only at request time and
# are never persisted in source URLs, SQLite records, snapshots, or reports.
KOSIS_API_KEY=
DATA_GO_KR_SERVICE_KEY=
